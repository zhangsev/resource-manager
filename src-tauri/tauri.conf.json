{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResManager",
  "version": "0.1.0",
  "identifier": "com.resmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResManager 资源管理",
        "url": "index.html",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "launcher",
        "title": "ResManager 搜索",
        "url": "index.html",
        "width": 720,
        "height": 480,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true
      },
      {
        "label": "quickadd",
        "title": "ResManager 快速添加",
        "url": "index.html",
        "width": 600,
        "height": 230,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
